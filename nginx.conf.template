# Gabarit rendu au demarrage du conteneur : `${BACKEND_URL}` est remplace par `envsubst`, donc la
# meme image sert staging et production. Toute autre variable d'environnement presente serait
# substituee elle aussi — d'ou l'absence de `$` litteral hors des variables nginx echappees.
#
# Copie raisonnee de celui du frontend : les pieges qui y sont documentes valent ici a l'identique,
# et les redecouvrir un par un couterait le meme temps qu'ils ont deja coute une fois.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compression du texte : le bundle Angular est essentiellement du JavaScript, il se compresse
    # d'un facteur quatre a cinq. Les images et les polices sont deja compressees, les inclure
    # couterait du processeur pour rien.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ── L'API ────────────────────────────────────────────────────────────────────────────────
    # Relayee vers le backend, sans reecrire le chemin : celui-ci sert deja sous `/api/v1/...`
    # (voir `nc.sillage.shared.ApiVersion`). Une barre finale a `proxy_pass` amputerait le prefixe
    # et toutes les routes tomberaient en 404.
    #
    # Le navigateur ne voit donc qu'une seule origine : aucun CORS a configurer, et les URL du
    # client restent relatives comme en developpement.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        # Le backend est joint en HTTPS sur un nom d'hote qui lui est propre : sans ces deux
        # lignes, la negociation TLS presenterait le mauvais nom (SNI) et le certificat serait
        # rejete.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;

        # `Origin` est transmis tel quel, **deliberement**. Le supprimer fait disparaitre les 403
        # « Invalid CORS request » que seul le navigateur voit, mais desactive un controle de
        # securite depuis un autre depot que celui qui en depend. **Le domaine de ce backoffice
        # doit etre declare cote backend** (`CORS_ALLOWED_ORIGINS`), la ou vit le code qui le lit.
        # Ne pas reintroduire de `proxy_set_header Origin ""` ici.

        # Le conteneur backend est **prive** : la passerelle Scaleway rejette toute requete sans ce
        # jeton, avant meme de demarrer une instance.
        #
        # Ce backoffice a besoin de **sa propre** cle API IAM — application
        # `sillage-backoffice-proxy`, permission set `ContainersPrivateAccess` — et non de celle du
        # frontend : partager une cle rendrait impossible de la revoquer d'un cote sans couper
        # l'autre. Elle se pose en variable d'environnement **secrete** `BACKEND_TOKEN`.
        #
        # Si elle manque, `envsubst` laisse l'en-tete vide et **tous** les appels API tombent en
        # 403 **au corps vide** — c'est la passerelle qui repond, pas Spring, qui renverrait du
        # JSON. Le corps vide est le signe distinctif, et c'est la premiere chose a verifier devant
        # un backoffice qui s'affiche mais refuse toute action. Meme symptome le jour ou la cle
        # expire, et l'expiration n'est pas optionnelle.
        proxy_set_header X-Auth-Token ${BACKEND_TOKEN};

        # L'adresse reelle du client, que le backend ne verrait plus autrement — le proxy est
        # desormais son seul interlocuteur.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Un export ou une reprise de donnees peuvent depasser la minute par defaut.
        proxy_read_timeout 120s;
    }

    # ── Les fichiers empreintes ──────────────────────────────────────────────────────────────
    # Angular empreinte ses paquets (`chunk-22KAZ5CB.js`) : le contenu ne change jamais sous un
    # meme nom, donc un an et `immutable` sont exacts.
    #
    # Expression **entre guillemets** : sans eux, nginx lit l'accolade de `{8}` comme une ouverture
    # de bloc et **refuse de demarrer**. Le piege est double, car `nginx -t` sur une image ou le
    # gabarit n'a pas ete deploye dans `conf.d/` valide la configuration **par defaut** et repond
    # « syntax is ok » sans avoir rien lu de la notre : la seule verification qui vaut est de
    # demarrer le conteneur.
    location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── Les fichiers a nom stable ────────────────────────────────────────────────────────────
    # Tout ce qui vient de `public/` garde son nom d'un deploiement a l'autre, mais son contenu
    # peut changer. Les servir `immutable` un an, comme le faisait une regle filtrant sur
    # l'extension, revient a promettre que les octets ne bougeront jamais : le jour ou l'un change,
    # le deploiement reussit, la version annoncee est la bonne, et l'octet servi reste perime —
    # y compris dans le cache de Cloudflare, pour un an.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        add_header Cache-Control "public, max-age=3600, must-revalidate";
        try_files $uri =404;
    }

    # `version.json` repond « qu'est-ce qui tourne reellement ? », question qui precede tout
    # diagnostic. Une reponse mise en cache mentirait exactement au moment ou l'on a besoin
    # qu'elle dise vrai.
    location = /version.json {
        add_header Cache-Control "no-store";
    }

    # `index.html` ne doit **jamais** etre mis en cache : c'est le seul fichier dont le nom est
    # stable, et c'est lui qui designe les empreintes du deploiement courant. Un navigateur qui
    # garderait l'ancien reclamerait des fichiers supprimes — page blanche apres chaque livraison,
    # sans erreur visible.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Repli SPA : `/organisations` n'existe pas sur le disque, seulement dans le routeur Angular.
    # Sans cette ligne, recharger la page ou ouvrir un lien direct renvoie 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
